@model ProductImage
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "ProductImage DELETE";
    Layout = "_Layout";
}

<div class="container mt-4">
    <div class="card border-danger shadow">
        <div class="card-header bg-danger text-white">
            <h3>Delete Image</h3>
        </div>
        <div class="card-body">
            <div class="alert alert-warning">
                <strong>Warning!</strong> Are you sure you want to delete this image?
            </div>
            <dl class="row">
                <dt class="col-sm-3">Id</dt>
                <dd class="col-sm-9">@Model.Id</dd>
                <dt class="col-sm-3">ImageUrl</dt>
                <dd class="col-sm-9">@Model.ImageUrl</dd>
                <dt class="col-sm-3">ProductId</dt>
                <dd class="col-sm-9">@Model.ProductId</dd>
            </dl>
            <img src="~/img/@Model.ImageUrl" width="300" alt="Product Image" />
            <form asp-action="DeletePost" asp-controller="Image" method="post">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger">Delete</button>
                <a asp-action="Index" asp-controller="Image" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>
